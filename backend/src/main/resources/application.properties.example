# Copy to application.properties (gitignored) and adjust. Defaults match ../docker-compose.yml,
# which publishes Postgres on host port 5434 so it does not clash with a local install on 5432.
spring.application.name=fpis-fondrum

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5434/fondrum}
spring.datasource.username=${DB_USERNAME:fondrum}
spring.datasource.password=${DB_PASSWORD:fondrum}

spring.jpa.hibernate.ddl-auto=update

# "dev" seeds sample wines and an order on first start. Remove outside local development.
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}

# Comma-separated list of origins allowed to call the API.
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:4200}
